---

---

<footer id="iletisim" class="bg-neutral-900 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      {/* Brand */}
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/images/logo.svg" alt="Vazifem" class="h-8 w-auto brightness-0 invert" />
          <span class="text-xl font-bold text-white font-serif">Vazifem</span>
        </div>
        <p class="text-neutral-400 text-sm leading-relaxed max-w-xs mb-5">
          Sevdiklerinizin mezarları için güvenilir, şeffaf ve kontrol edilebilir bakım hizmeti.
        </p>
        <div class="flex flex-col sm:flex-row gap-2.5">
          <a
            href="https://play.google.com/store/apps/details?id=com.vazifem.customer&hl=tr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Play'den indirin"
            class="inline-flex items-center gap-2.5 h-12 px-3.5 rounded-lg bg-white/10 border border-white/25 text-white hover:bg-white/20 hover:-translate-y-px transition-all duration-200"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92z" fill="#00A8DE"/>
              <path d="M16.81 8.819l2.302 1.331c.578.331.578 1.169 0 1.5l-2.302 1.331L13.792 12l3.018-3.181z" fill="#E0AC03"/>
              <path d="M13.792 12l3.018 3.181-12.611 7.286a1.05 1.05 0 01-1.218-.34L13.792 12z" fill="#DD3036"/>
              <path d="M13.792 12L2.981 1.873c.273-.288.696-.418 1.218-.34l12.611 7.286L13.792 12z" fill="#00A856"/>
            </svg>
            <span class="flex flex-col leading-[1.1] text-left">
              <span class="text-[10px] font-normal text-white/70">İndirin</span>
              <span class="text-[14px] font-semibold tracking-[-0.01em] mt-0.5">Google Play</span>
            </span>
          </a>
          <a
            href="https://apps.apple.com/tr/app/vazifem-mezar-bak%C4%B1m%C4%B1/id6760430412"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="App Store'dan indirin"
            class="inline-flex items-center gap-2.5 h-12 px-3.5 rounded-lg bg-white/10 border border-white/25 text-white hover:bg-white/20 hover:-translate-y-px transition-all duration-200"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
              <path d="M17.523 12.04c-.029-2.79 2.281-4.13 2.387-4.196-1.305-1.906-3.331-2.166-4.046-2.196-1.708-.179-3.359 1.02-4.227 1.02-.886 0-2.215-.997-3.65-.97-1.85.027-3.6 1.094-4.56 2.762-1.97 3.41-.501 8.435 1.397 11.193.93 1.36 2.038 2.876 3.475 2.823 1.402-.057 1.928-.911 3.622-.911 1.681 0 2.165.911 3.633.882 1.503-.026 2.45-1.372 3.353-2.74 1.07-1.572 1.504-3.105 1.523-3.183-.034-.013-2.92-1.119-2.949-4.484zM14.738 3.816c.764-.917 1.273-2.196 1.137-3.475-1.097.045-2.42.73-3.211 1.648-.71.812-1.328 2.119-1.165 3.366 1.222.094 2.476-.62 3.24-1.539z"/>
            </svg>
            <span class="flex flex-col leading-[1.1] text-left">
              <span class="text-[10px] font-normal text-white/70">İndirin</span>
              <span class="text-[14px] font-semibold tracking-[-0.01em] mt-0.5">App Store</span>
            </span>
          </a>
        </div>
      </div>

      {/* Quick links */}
      <div>
        <h4 class="text-sm font-semibold text-neutral-300 uppercase tracking-wider mb-4">
          Hızlı Bağlantılar
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/#ana-sayfa" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Ana Sayfa
            </a>
          </li>
          <li>
            <a href="/#nasil-calisir" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Nasıl Çalışır
            </a>
          </li>
          <li>
            <a href="/#hizmet-saglayiciyim" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Hizmet Sağlayıcıyım
            </a>
          </li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 class="text-sm font-semibold text-neutral-300 uppercase tracking-wider mb-4">
          İletişim
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="mailto:support@vazifem.com" class="text-neutral-400 hover:text-white transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              support@vazifem.com
            </a>
          </li>
          <li>
            <a href="tel:+905315526718" class="text-neutral-400 hover:text-white transition-colors text-sm flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +90 531 552 67 18
            </a>
          </li>
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h4 class="text-sm font-semibold text-neutral-300 uppercase tracking-wider mb-4">
          Yasal
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/kvkk-aydinlatma-metni" class="text-neutral-400 hover:text-white transition-colors text-sm">
              KVKK Aydınlatma Metni
            </a>
          </li>
          <li>
            <a href="/gizlilik-politikasi" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Gizlilik Politikası
            </a>
          </li>
          <li>
            <a href="/kullanim-kosullari" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Kullanım Koşulları
            </a>
          </li>
          <li>
            <a href="/hesap-silme" class="text-neutral-400 hover:text-white transition-colors text-sm">
              Hesap Silme
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-12 pt-8 border-t border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-neutral-500 text-sm">
        &copy; {new Date().getFullYear()} Vazifem. Tüm hakları saklıdır.
      </p>
      <a
        href="https://www.instagram.com/vazifemcom"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="text-neutral-400 hover:text-white transition-colors duration-200"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</footer>
